# LLM
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK=false

# Embedding
# mock = offline hashed-ngram embeddings (no API key, used by all tests)
# any other value = OpenAI-compatible /embeddings endpoint, needs BASE_URL (+ MODEL)
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Only used by the mock provider: hash space size. Larger = fewer accidental
# collisions between unrelated texts (1024 separates relevant / irrelevant well).
EMBEDDING_DIMENSIONS=1024

# Knowledge base / RAG
DOCUMENTS_DIR=./data/documents
CHROMA_PATH=./data/runtime/chroma
CHROMA_COLLECTION=hengguang_knowledge
# Chunking in Chinese characters (SPEC section 6.2: 800-1200 / 100-200)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# Default number of recalled chunks and the score below which a chunk is
# considered irrelevant (SPEC section 6.3: top_k=5). 0.12 is the single default that also
# works in the real-embedding mode; see .env.local.example for the measured band.
RAG_TOP_K=5
RAG_MIN_SCORE=0.12

# Agent runtime safety limits (Day 3)
AGENT_MAX_STEPS=5
AGENT_MAX_TOOL_CALLS=8

# Storage (Day 4): the synthetic business database + audit trail.
# Created and seeded automatically on first start (app.db.seed), gitignored.
DATABASE_URL=sqlite:///./data/runtime/app.db
# Catalog + generation parameters live in SYNTHETIC_DIR (schema.sql / seed.json)
SYNTHETIC_DIR=./data/synthetic
# Max rows a business tool returns in one call (the text block is smaller: 8 rows)
MAX_TOOL_ROWS=50

# Observability (Day 4)
# LOG_LEVEL: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# LOG_JSON=false -> human readable single-line logs (dev); true -> structured JSON
LOG_JSON=true

# Auth (Day 4)
# RBAC is always on. There is no "auth disabled" switch on purpose: the three demo
# bearer tokens below are fixed constants (no JWT / login / SSO) and are documented
# in README.md and DEMO_SCRIPT.md so the demo can be run with plain curl.
#   admin    -> demo-admin-token
#   manager  -> demo-manager-token
#   operator -> demo-operator-token

# Server
APP_VERSION=0.1.0
