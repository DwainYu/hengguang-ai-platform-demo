# LLM
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embedding
# mock = offline hashed-ngram embeddings (no API key, used by all tests)
# any other value = OpenAI-compatible /embeddings endpoint, needs BASE_URL (+ MODEL)
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Only used by the mock provider: hash space size. Larger = fewer accidental
# collisions between unrelated texts (1024 separates relevant / irrelevant well).
EMBEDDING_DIMENSIONS=1024

# Knowledge base / RAG
DOCUMENTS_DIR=./data/documents
CHROMA_PATH=./data/runtime/chroma
CHROMA_COLLECTION=hengguang_knowledge
# Chunking in Chinese characters (SPEC section 6.2: 800-1200 / 100-200)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# Default number of recalled chunks and the score below which a chunk is
# considered irrelevant (SPEC section 6.3: top_k=5)
RAG_TOP_K=5
RAG_MIN_SCORE=0.10

# Storage
DATABASE_URL=sqlite:///./data/runtime/app.db

# Server
APP_VERSION=0.1.0
