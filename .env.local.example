# Local Real Embedding 开发模式（experiment/local-qwen3-embedding 分支）
#
# 这是「同一套 app/ 代码 + 本机 Ollama 真实向量模型」的开发配置，
# 不是新的默认部署：Docker Compose 仍然使用 mock embedding。
#
#   cp .env.local.example .env.local      # .env.local 已 gitignore
#   ./scripts/run-local-real-embedding.sh # 脚本内置同样的默认值，不依赖本文件
#
# 仓库根目录的 .env（Docker 用）不会被本文件读取、修改或覆盖。

# --- LLM：真实 ModelScope（key 由环境变量 / 交互输入提供，脚本绝不打印） ---
LLM_PROVIDER=modelscope
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
LLM_MODEL=Qwen/Qwen3.8-Flash-Next
# LLM_API_KEY 留空：脚本按 MODELSCOPE_API_KEY → 仓库 .env 的 LLM_API_KEY → 交互输入 的顺序取用
LLM_API_KEY=
LLM_FALLBACK=false

# --- Embedding：本机 Ollama 的 Qwen3-Embedding-0.6B（OpenAI-compatible /v1/embeddings） ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- 知识库必须与默认部署隔离：不同 provider 的向量空间互不兼容 ---
# 独立目录（gitignore），绝不写 Docker 默认的 ./data/runtime/chroma
CHROMA_PATH=./data/local-real-embedding/chroma
CHROMA_COLLECTION=hengguang_knowledge_qwen3
# 独立 SQLite：与 api 容器共用同一个 app.db 会争抢写锁（实测 database is locked）
DATABASE_URL=sqlite:///./data/local-real-embedding/app.db

# --- RAG 阈值：两个向量空间同查询实测后，统一到 0.12 ---
# Qwen3 空间：域内 top1 最低 0.3284 / 域内第 5 位最低 0.2077；通用域外最高 0.1083
#            → 0.12 对召回无损，又能挡住通用域外
# mock  空间：合法域内 top1 最低 0.1244（0.15 会把它滤成空）；词面重叠域外最高 0.1041
# 0.15 只是第一轮 A/B（只覆盖 Qwen3 一侧）的结论，v0.1.2 起两个模式统一用 0.12
RAG_TOP_K=5
RAG_MIN_SCORE=0.12

# --- 本地可读日志（容器里用 JSON） ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- 脚本自身的可选开关 ---
# LOCAL_REAL_EMBEDDING_PORT=8001
# LOCAL_REAL_EMBEDDING_DIR=./data/local-real-embedding

# --- 用本地 Web Console 驱动这个实例（同源 dev proxy，不需要 CORS） ---
# cd web && npm run dev:local     # 等价于 VITE_API_PROXY_TARGET=http://127.0.0.1:8001 npm run dev
# 不带该变量时，Vite dev proxy 仍默认指向 http://127.0.0.1:8000（Docker/main 行为不变）
